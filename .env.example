# MVSA public site — environment variables
#
# Every variable here is SERVER-ONLY on purpose. None of them may be renamed to
# NEXT_PUBLIC_*: that prefix inlines the value into the browser bundle, and the
# bearer token below would then be readable by anyone who views the page source.
# All backend calls happen in server components and route handlers.

# Base URL of the MVSA backend (no trailing slash, no /v1 suffix).
# The backend is not currently reachable from the public internet — see
# docs/backend-migration.md before setting this in Vercel.
MVSA_API_BASE_URL=http://localhost:8080

# Bearer token for the backend (HTTP bearer auth, every endpoint except health).
MVSA_API_TOKEN=

# Tenant the site books against. Must match the backend's MVSA_TENANT_ID.
MVSA_API_TENANT_ID=mvsa

# Per-request timeout in milliseconds for backend calls (default 8000).
MVSA_API_TIMEOUT_MS=8000

# Booking writes (POST /v1/customers/resolve, /v1/holds, /v1/bookings).
# Defaults to false. Leave it false until the website customer-resolution
# question in docs/backend-migration.md is answered: with writes disabled the
# booking widget still shows live availability and hands the customer over to
# WhatsApp/phone instead of pretending to hold a slot.
MVSA_BOOKING_WRITES_ENABLED=false
